{
  "name": "@animespace/monorepo",
  "version": "0.1.0-beta.25",
  "private": true,
  "scripts": {
    "anime": "tsx apps/animespace/src/cli.ts",
    "build": "turbo run build --filter !@animespace/docs",
    "build:all": "turbo run build",
    "build:docs": "turbo run build --filter @animespace/docs",
    "dev:docs": "pnpm -C apps/docs dev",
    "format": "turbo run format --parallel",
    "release": "bumpp package.json apps/*/package.json packages/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "pnpm test:ci"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.19.2",
    "bumpp": "latest",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=v24.0.0"
  }
}
